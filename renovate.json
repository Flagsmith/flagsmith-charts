{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [":semanticCommitTypeAll(deps)"],
    "semanticCommits": "enabled",
    "semanticCommitScope": "",
    "enabledManagers": ["custom.regex"],
    "gitIgnoredAuthors": ["216534828+flagsmith-engineering[bot]@users.noreply.github.com"],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Flagsmith version used as the chart's appVersion, which is the default tag for the API, frontend and task processor images",
            "managerFilePatterns": ["/^charts/flagsmith/Chart\\.yaml$/"],
            "matchStrings": ["\\nappVersion: [\"']?(?<currentValue>[^\\s\"']+)"],
            "datasourceTemplate": "docker",
            "depNameTemplate": "flagsmith/flagsmith-api"
        }
    ],
    "packageRules": [
        {
            "description": "Keep the commit message the release-please changelog already uses, e.g. `deps: bump Flagsmith from 2.285.0 to 2.286.0`",
            "matchManagers": ["custom.regex"],
            "matchDepNames": ["flagsmith/flagsmith-api"],
            "commitMessageAction": "bump",
            "commitMessageTopic": "Flagsmith",
            "commitMessageExtra": "from {{currentValue}} to {{newValue}}",
            "branchTopic": "flagsmith",
            "addLabels": ["dependencies"]
        }
    ]
}
